// ---------- helpers ----------
async function askClaude(prompt, system) {
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-6",
      max_tokens: 1000,
      system,
      messages: [{ role: "user", content: prompt }],
    }),
  });
  const data = await res.json();
  const text = (data.content || [])
    .filter((b) => b.type === "text")
    .map((b) => b.text)
    .join("\n");
  return text;
}

function extractJSON(text) {
  const cleaned = text.replace(/```json|```/g, "").trim();
  const start = cleaned.indexOf("{");
  const end = cleaned.lastIndexOf("}");
  return JSON.parse(cleaned.slice(start, end + 1));
}

function scoreColor(score) {
  if (score >= 80) return "var(--good)";
  if (score >= 60) return "var(--warn)";
  return "var(--bad)";
}

let uid = 1;

const SAMPLE_JD = `Senior Backend Engineer (Java)

We're looking for a Senior Backend Engineer to design and build services powering our platform.

Requirements:
- 5+ years building production backend systems
- Strong Java experience, Spring Boot preferred
- Experience with REST API design and relational databases
- Familiarity with cloud deployment (AWS/GCP/Azure)
- Comfortable owning a service end-to-end

Nice to have:
- Experience with event-driven systems (Kafka, RabbitMQ)
- Exposure to AI/LLM integration
- Mentorship or tech-lead experience`;

const SAMPLE_RESUMES = [
  {
    name: "Priya Nair",
    text: `Priya Nair — Backend Engineer
6 years experience building Java/Spring Boot microservices at fintech companies.
Led migration of a monolith to microservices on AWS, owned REST APIs serving 2M+ req/day.
Experience with Kafka for event streaming, PostgreSQL, and Docker/Kubernetes.
Mentored 3 junior engineers. B.Tech Computer Science.`,
  },
  {
    name: "Daniel Osei",
    text: `Daniel Osei — Frontend Developer
4 years experience with React, TypeScript, and Node.js.
Built dashboards and internal tools, some light Express.js API work.
No formal Java experience. Familiar with basic SQL.
B.Sc Information Systems.`,
  },
  {
    name: "Wei Zhang",
    text: `Wei Zhang — Software Engineer
7 years in backend development, primarily Java and Spring Boot.
Designed REST APIs and owned services deployed on GCP.
Integrated an OpenAI-based support assistant into a customer service tool.
Experience with RabbitMQ and MySQL. Tech lead for a 4-person team.`,
  },
];

export default function ResumeScreener() {
  const [tab, setTab] = useState("screen");
  const [jd, setJd] = useState(SAMPLE_JD);
  const [candidates, setCandidates] = useState([]);
  const [pasteName, setPasteName] = useState("");
  const [pasteText, setPasteText] = useState("");
  const [chat, setChat] = useState([]);
  const [chatInput, setChatInput] = useState("");
  const [chatLoading, setChatLoading] = useState(false);
  const [threshold, setThreshold] = useState(70);
  const [schedule, setSchedule] = useState({});
  const fileRef = useRef(null);

  const scored = candidates.filter((c) => c.status === "scored");
  const ranked = useMemo(
    () => [...scored].sort((a, b) => b.score - a.score),
    [scored]
  );
  const shortlisted = ranked.filter((c) => c.score >= threshold);

  function addCandidate(name, text) {
    const c = { id: uid++, name, resumeText: text, status: "pending" };
    setCandidates((prev) => [...prev, c]);
    scoreCandidate(c);
  }

  function loadSamples() {
    SAMPLE_RESUMES.forEach((r) => addCandidate(r.name, r.text));
  }

  async function handleFiles(fileList) {
    for (const file of Array.from(fileList)) {
      const text = await file.text();
      addCandidate(file.name.replace(/\.[^/.]+$/, ""), text);
    }
  }

  async function scoreCandidate(c) {
    setCandidates((prev) =>
      prev.map((x) => (x.id === c.id ? { ...x, status: "scoring" } : x))
    );
    try {
      const prompt = `Job description:\n"""${jd}"""\n\nCandidate resume:\n"""${c.resumeText}"""\n\nEvaluate this candidate against the job description. Respond with ONLY a JSON object, no other text, matching exactly this shape:\n{"score": <integer 0-100>, "summary": "<2 sentence summary>", "strengths": ["...", "..."], "gaps": ["...", "..."]}`;
      const raw = await askClaude(
        prompt,
        "You are an experienced technical recruiter. Be calibrated and specific in scoring. Respond only with valid JSON, no markdown fences, no preamble."
      );
      const parsed = extractJSON(raw);
      setCandidates((prev) =>
        prev.map((x) =>
          x.id === c.id
            ? {
                ...x,
                status: "scored",
                score: parsed.score,
                summary: parsed.summary,
                strengths: parsed.strengths || [],
                gaps: parsed.gaps || [],
              }
            : x
        )
      );
    } catch (e) {
      setCandidates((prev) =>
        prev.map((x) =>
          x.id === c.id ? { ...x, status: "error", error: String(e) } : x
        )
      );
    }
  }

  async function sendChat() {
    if (!chatInput.trim() || scored.length === 0) return;
    const question = chatInput.trim();
    setChat((prev) => [...prev, { role: "user", text: question }]);
    setChatInput("");
    setChatLoading(true);
    try {
      const context = scored
        .map(
          (c) =>
            `${c.name} — score ${c.score}/100. Summary: ${c.summary} Strengths: ${(
              c.strengths || []
            ).join("; ")}. Gaps: ${(c.gaps || []).join("; ")}.`
        )
        .join("\n");
      const raw = await askClaude(
        `Job description:\n${jd}\n\nCandidates on file:\n${context}\n\nRecruiter question: ${question}\n\nAnswer clearly and specifically, referencing candidates by name where relevant.`,
        "You are a helpful recruiting assistant answering a recruiter's questions about a pool of already-screened candidates. Be concise and concrete."
      );
      setChat((prev) => [...prev, { role: "assistant", text: raw }]);
    } catch (e) {
      setChat((prev) => [
        ...prev,
        { role: "assistant", text: "Something went wrong reaching the model." },
      ]);
    } finally {
      setChatLoading(false);
    }
  }

  function setSlot(id, field, value) {
    setSchedule((prev) => ({
      ...prev,
      [id]: { ...prev[id], [field]: value },
    }));
  }

  function confirmSlot(id) {
    setSchedule((prev) => ({
      ...prev,
      [id]: { ...prev[id], confirmed: true },
    }));
  }

  return (
    <div className="hs-root">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap');

        .hs-root {
          --bg: #12151b;
          --surface: #1a1f28;
          --surface-2: #212734;
          --border: #2b3240;
          --text: #e9ebee;
          --text-dim: #909aac;
          --accent: #e6b143;
          --accent-dim: #3a2f18;
          --good: #56d18b;
          --warn: #e6b143;
          --bad: #ee7b6f;
          background: var(--bg);
          color: var(--text);
          font-family: 'IBM Plex Sans', sans-serif;
          min-height: 100vh;
          border-radius: 12px;
          overflow: hidden;
        }
        .hs-serif { font-family: 'Fraunces', serif; }
        .hs-mono { font-family: 'IBM Plex Mono', monospace; }

        .hs-header {
          padding: 28px 32px 20px;
          border-bottom: 1px solid var(--border);
        }
        .hs-tabs {
          display: flex;
          gap: 4px;
          padding: 0 32px;
          border-bottom: 1px solid var(--border);
          background: var(--surface);
        }
        .hs-tab {
          padding: 12px 16px;
          font-size: 13.5px;
          color: var(--text-dim);
          cursor: pointer;
          border-bottom: 2px solid transparent;
          background: none;
          border-top: none;
          border-left: none;
          border-right: none;
          font-family: 'IBM Plex Sans', sans-serif;
        }
        .hs-tab.active {
          color: var(--text);
          border-bottom: 2px solid var(--accent);
        }
        .hs-body { padding: 28px 32px 40px; }

        .hs-card {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 10px;
          padding: 18px 20px;
        }
        .hs-input, .hs-textarea {
          background: var(--surface-2);
          border: 1px solid var(--border);
          border-radius: 8px;
          color: var(--text);
          padding: 10px 12px;
          font-size: 13.5px;
          font-family: 'IBM Plex Sans', sans-serif;
          width: 100%;
        }
        .hs-textarea { resize: vertical; }
        .hs-btn {
          background: var(--accent);
          color: #1a1305;
          border: none;
          border-radius: 8px;
          padding: 9px 16px;
          font-size: 13.5px;
          font-weight: 600;
          cursor: pointer;
        }
        .hs-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        .hs-btn-ghost {
          background: transparent;
          border: 1px solid var(--border);
          color: var(--text);
          border-radius: 8px;
          padding: 9px 16px;
          font-size: 13.5px;
          cursor: pointer;
        }
        .hs-dropzone {
          border: 1px dashed var(--border);
          border-radius: 10px;
          padding: 22px;
          text-align: center;
          color: var(--text-dim);
          cursor: pointer;
        }
        .hs-scorebar-track {
          background: var(--surface-2);
          border-radius: 6px;
          height: 6px;
          overflow: hidden;
          width: 100%;
        }
        .hs-scorebar-fill { height: 100%; border-radius: 6px; }
      `}</style>

      <div className="hs-header">
        <div style={{ fontSize: 22 }} className="hs-serif">
          Sift — AI screening desk
        </div>
        <div style={{ fontSize: 13, color: "var(--text-dim)", marginTop: 4 }}>
          Parse resumes, score against a role, shortlist, ask questions, schedule interviews.
        </div>
      </div>

      <div className="hs-tabs">
        {[
          ["screen", "Screen"],
          ["shortlist", `Shortlist (${shortlisted.length})`],
          ["ask", "Ask"],
          ["schedule", "Schedule"],
        ].map(([key, label]) => (
          <button
            key={key}
            className={"hs-tab" + (tab === key ? " active" : "")}
            onClick={() => setTab(key)}
          >
            {label}
          </button>
        ))}
      </div>

      <div className="hs-body">
        {tab === "screen" && (
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 20 }}>
            <div className="hs-card">
              <div style={{ fontSize: 13, fontWeight: 600, marginBottom: 10 }}>
                Job description
              </div>
              <textarea
                className="hs-textarea"
                rows={12}
                value={jd}
                onChange={(e) => setJd(e.target.value)}
              />
              <div style={{ fontSize: 12, color: "var(--text-dim)", marginTop: 8 }}>
                Existing candidates score against whatever is here — edit and they'll need re-scoring.
              </div>
            </div>

            <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
              <div className="hs-card">
                <div style={{ fontSize: 13, fontWeight: 600, marginBottom: 10 }}>
                  Add a candidate
                </div>
                <div
                  className="hs-dropzone"
                  onClick={() => fileRef.current?.click()}
                  onDragOver={(e) => e.preventDefault()}
                  onDrop={(e) => {
                    e.preventDefault();
                    handleFiles(e.dataTransfer.files);
                  }}
                >
                  Drop .txt resumes here, or click to browse
                  <input
                    ref={fileRef}
                    type="file"
                    accept=".txt"
                    multiple
                    style={{ display: "none" }}
                    onChange={(e) => handleFiles(e.target.files)}
                  />
                </div>
                <div style={{ fontSize: 11, color: "var(--text-dim)", margin: "8px 0" }}>
                  This demo parses plain text client-side. The production build (Spring Boot + Apache PDFBox/POI) handles real .pdf/.docx uploads.
                </div>

                <div style={{ marginTop: 12, display: "flex", flexDirection: "column", gap: 8 }}>
                  <input
                    className="hs-input"
                    placeholder="Candidate name"
                    value={pasteName}
                    onChange={(e) => setPasteName(e.target.value)}
                  />
                  <textarea
                    className="hs-textarea"
                    rows={5}
                    placeholder="Or paste resume text here"
                    value={pasteText}
                    onChange={(e) => setPasteText(e.target.value)}
                  />
                  <div style={{ display: "flex", gap: 8 }}>
                    <button
                      className="hs-btn"
                      disabled={!pasteName.trim() || !pasteText.trim()}
                      onClick={() => {
                        addCandidate(pasteName.trim(), pasteText.trim());
                        setPasteName("");
                        setPasteText("");
                      }}
                    >
                      Score candidate
                    </button>
                    <button className="hs-btn-ghost" onClick={loadSamples}>
                      Load 3 sample resumes
                    </button>
                  </div>
                </div>
              </div>

              <div className="hs-card" style={{ maxHeight: 360, overflowY: "auto" }}>
                <div style={{ fontSize: 13, fontWeight: 600, marginBottom: 10 }}>
                  Candidates ({candidates.length})
                </div>
                {candidates.length === 0 && (
                  <div style={{ fontSize: 13, color: "var(--text-dim)" }}>
                    No candidates yet — add one on the left.
                  </div>
                )}
                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {candidates.map((c) => (
                    <div key={c.id}>
                      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                        <div style={{ fontSize: 13.5 }}>{c.name}</div>
                        {c.status === "scoring" && (
                          <span className="hs-mono" style={{ fontSize: 12, color: "var(--text-dim)" }}>
                            scoring…
                          </span>
                        )}
                        {c.status === "error" && (
                          <span style={{ fontSize: 12, color: "var(--bad)" }}>failed</span>
                        )}
                        {c.status === "scored" && (
                          <span className="hs-mono" style={{ fontSize: 13, color: scoreColor(c.score) }}>
                            {c.score}
                          </span>
                        )}
                      </div>
                      {c.status === "scored" && (
                        <>
                          <div className="hs-scorebar-track" style={{ marginTop: 4 }}>
                            <div
                              className="hs-scorebar-fill"
                              style={{ width: `${c.score}%`, background: scoreColor(c.score) }}
                            />
                          </div>
                          <div style={{ fontSize: 12, color: "var(--text-dim)", marginTop: 4 }}>
                            {c.summary}
                          </div>
                        </>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {tab === "shortlist" && (
          <div>
            <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 18 }}>
              <span style={{ fontSize: 13, color: "var(--text-dim)" }}>Shortlist threshold</span>
              <input
                type="range"
                min={0}
                max={100}
                value={threshold}
                onChange={(e) => setThreshold(Number(e.target.value))}
              />
              <span className="hs-mono" style={{ fontSize: 13 }}>{threshold}</span>
            </div>

            {ranked.length === 0 ? (
              <div style={{ color: "var(--text-dim)", fontSize: 13 }}>
                Score some candidates in the Screen tab first.
              </div>
            ) : (
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {ranked.map((c, i) => (
                  <div
                    key={c.id}
                    className="hs-card"
                    style={{
                      display: "grid",
                      gridTemplateColumns: "32px 1fr 90px",
                      gap: 16,
                      alignItems: "start",
                      opacity: c.score >= threshold ? 1 : 0.55,
                    }}
                  >
                    <div className="hs-mono" style={{ color: "var(--text-dim)", paddingTop: 2 }}>
                      {String(i + 1).padStart(2, "0")}
                    </div>
                    <div>
                      <div style={{ fontSize: 14.5, fontWeight: 600 }}>{c.name}</div>
                      <div style={{ fontSize: 12.5, color: "var(--text-dim)", marginTop: 3 }}>
                        {c.summary}
                      </div>
                      <div style={{ display: "flex", gap: 18, marginTop: 8, fontSize: 12 }}>
                        <div>
                          <div style={{ color: "var(--good)", marginBottom: 2 }}>Strengths</div>
                          {(c.strengths || []).map((s, j) => (
                            <div key={j} style={{ color: "var(--text-dim)" }}>• {s}</div>
                          ))}
                        </div>
                        <div>
                          <div style={{ color: "var(--bad)", marginBottom: 2 }}>Gaps</div>
                          {(c.gaps || []).map((s, j) => (
                            <div key={j} style={{ color: "var(--text-dim)" }}>• {s}</div>
                          ))}
                        </div>
                      </div>
                    </div>
                    <div className="hs-mono" style={{ fontSize: 22, color: scoreColor(c.score), textAlign: "right" }}>
                      {c.score}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {tab === "ask" && (
          <div className="hs-card" style={{ display: "flex", flexDirection: "column", height: 480 }}>
            <div style={{ flex: 1, overflowY: "auto", display: "flex", flexDirection: "column", gap: 12 }}>
              {chat.length === 0 && (
                <div style={{ fontSize: 13, color: "var(--text-dim)" }}>
                  Ask things like "who has the strongest cloud experience?" or "compare the top two candidates."
                </div>
              )}
              {chat.map((m, i) => (
                <div
                  key={i}
                  style={{
                    alignSelf: m.role === "user" ? "flex-end" : "flex-start",
                    background: m.role === "user" ? "var(--accent-dim)" : "var(--surface-2)",
                    border: "1px solid var(--border)",
                    borderRadius: 10,
                    padding: "8px 12px",
                    maxWidth: "80%",
                    fontSize: 13.5,
                    whiteSpace: "pre-wrap",
                  }}
                >
                  {m.text}
                </div>
              ))}
              {chatLoading && (
                <div style={{ fontSize: 13, color: "var(--text-dim)" }}>thinking…</div>
              )}
            </div>
            <div style={{ display: "flex", gap: 8, marginTop: 12 }}>
              <input
                className="hs-input"
                placeholder={scored.length === 0 ? "Score candidates first" : "Ask about your candidates…"}
                value={chatInput}
                disabled={scored.length === 0}
                onChange={(e) => setChatInput(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && sendChat()}
              />
              <button className="hs-btn" disabled={scored.length === 0 || chatLoading} onClick={sendChat}>
                Send
              </button>
            </div>
          </div>
        )}

        {tab === "schedule" && (
          <div>
            {shortlisted.length === 0 ? (
              <div style={{ color: "var(--text-dim)", fontSize: 13 }}>
                No one has cleared the shortlist threshold yet.
              </div>
            ) : (
              <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
                {shortlisted.map((c) => {
                  const s = schedule[c.id] || {};
                  return (
                    <div
                      key={c.id}
                      className="hs-card"
                      style={{ display: "grid", gridTemplateColumns: "1fr auto auto auto", gap: 12, alignItems: "center" }}
                    >
                      <div>
                        <div style={{ fontWeight: 600, fontSize: 14 }}>{c.name}</div>
                        <div className="hs-mono" style={{ fontSize: 12, color: scoreColor(c.score) }}>
                          score {c.score}
                        </div>
                      </div>
                      <input
                        type="date"
                        className="hs-input"
                        value={s.date || ""}
                        onChange={(e) => setSlot(c.id, "date", e.target.value)}
                      />
                      <input
                        type="time"
                        className="hs-input"
                        value={s.time || ""}
                        onChange={(e) => setSlot(c.id, "time", e.target.value)}
                      />
                      {s.confirmed ? (
                        <span style={{ color: "var(--good)", fontSize: 13 }}>Scheduled ✓</span>
                      ) : (
                        <button
                          className="hs-btn"
                          disabled={!s.date || !s.time}
                          onClick={() => confirmSlot(c.id)}
                        >
                          Confirm
                        </button>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
